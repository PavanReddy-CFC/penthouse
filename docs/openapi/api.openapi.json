          },
          "propertyType": {
            "type": "string",
            "enum": [
              "PENTHOUSE",
              "APARTMENT",
              "VILLA",
              "TOWNHOUSE",
              "PLOT"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PENDING",
              "SOLD",
              "WITHDRAWN"
            ]
          }
        }
      }
    },
    "parameters": {
      "Page": {
        "in": "query",
