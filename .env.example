# Template - copy to .env and adjust. Safe example values only.
#
# One file for all three apps (web, api, mls).
# - Settings without a prefix are shared by every app.
# - API_*, MLS_* and WEB_* settings apply to one app only.
# - Any shared backend setting can be overridden for one service by adding
#   API_ or MLS_ in front of it, e.g. MLS_DATABASE_POOL_MAX=20.
# - ${NAME} reuses a value defined above in this file.

# =================================================================
# Environment (all apps)
# =================================================================
APP_ENV=dev
NODE_ENV=development

# =================================================================
# Ports
# =================================================================
WEB_PORT=3000
API_PORT=4000
MLS_PORT=4020

# =================================================================
# Service names and API docs titles (per service)
# =================================================================
API_SERVICE_NAME=penthouselife-api
MLS_SERVICE_NAME=penthouselife-mls

API_SWAGGER_TITLE=PenthouseLife Main API
MLS_SWAGGER_TITLE=PenthouseLife MLS API
API_SWAGGER_DESCRIPTION=REST API documentation for the PenthouseLife Main API
MLS_SWAGGER_DESCRIPTION=REST API documentation for the PenthouseLife MLS API

# =================================================================
# HTTP server (both backends)
# =================================================================
HOST=0.0.0.0
# All backend routes are served under this prefix, e.g. /api/health
API_PREFIX=api
# Proxies in front of the backends: 0 locally, 1 on Railway (needed for per-visitor rate limits)
TRUST_PROXY_HOPS=0
# Maximum request body size
REQUEST_BODY_LIMIT=1mb
# error | warn | log | debug | verbose
LOG_LEVEL=debug

# =================================================================
# CORS (both backends)
# =================================================================
# Comma-separated list for several origins
CORS_ORIGIN=http://localhost:${WEB_PORT}
CORS_CREDENTIALS=true

# =================================================================
# Local services started by docker-compose.yml (development only)
# =================================================================
POSTGRES_USER=penthouse
POSTGRES_PASSWORD=penthouse_local_dev
POSTGRES_DB=penthouselife
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
# Memory for Elasticsearch (Java heap)
ELASTICSEARCH_HEAP=512m

# =================================================================
# Database - PostgreSQL via Prisma (both backends)
# =================================================================
# Format: postgresql://<db-user>:<db-password>@<host>:<port>/<database>
# Built from the POSTGRES_* values above; replace it to use another server.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Max connections each service keeps open
DATABASE_POOL_MAX=10
# Seconds to wait for a free connection from the pool
DATABASE_POOL_TIMEOUT_SECONDS=10
# Seconds to wait when opening a new connection
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# =================================================================
# Swagger / OpenAPI docs (both backends)
# =================================================================
SWAGGER_ENABLED=true
# Swagger UI at /api-docs, raw OpenAPI JSON at /api-docs.json
SWAGGER_PATH=api-docs
SWAGGER_VERSION=1.0.0

# =================================================================
# Rate limiting per client IP (both backends)
# =================================================================
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# =================================================================
# Pagination (both backends)
# =================================================================
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# =================================================================
# Web app - public values, inlined into the browser bundle at build time
# =================================================================
NEXT_PUBLIC_APP_NAME=PenthouseLife
NEXT_PUBLIC_API_URL=http://localhost:${API_PORT}/${API_PREFIX}
NEXT_PUBLIC_MLS_API_URL=http://localhost:${MLS_PORT}/${API_PREFIX}
NEXT_PUBLIC_API_DOCS_URL=http://localhost:${API_PORT}/${SWAGGER_PATH}
NEXT_PUBLIC_MLS_API_DOCS_URL=http://localhost:${MLS_PORT}/${SWAGGER_PATH}
# Abort backend requests after this many milliseconds
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# =================================================================
# Redis cache (MLS search results)
# Leave REDIS_URL empty to turn caching off.
# =================================================================
REDIS_URL=redis://localhost:${REDIS_PORT}
# Prepended to every key, so several apps can share one Redis
REDIS_KEY_PREFIX=penthouselife:
# How long a cached search result lives
REDIS_CACHE_TTL_SECONDS=300

# =================================================================
# Elasticsearch (MLS listing search)
# Leave ELASTICSEARCH_URL empty to turn search off.
# =================================================================
ELASTICSEARCH_URL=http://localhost:${ELASTICSEARCH_PORT}
# Only needed when Elasticsearch security is on (it is off in docker-compose.yml)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=penthouselife_listings
ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000
